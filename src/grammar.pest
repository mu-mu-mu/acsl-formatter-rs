WHITESPACE = _{ " " | "\t" | "\r" | "\n" }

expr_input = { SOI ~ expr ~ EOI }
expr_list = { SOI ~ (clause ~ (semicolon ~ clause)* ~ semicolon?)? ~ EOI }

clause = { behavior_clause | loop_invariant | assert_clause | requires_clause | ensures_clause | assumes_clause | assigns_clause | expr }
behavior_clause = { behavior_kw ~ ident ~ colon }
loop_invariant = { loop_kw ~ invariant_kw ~ expr }
assert_clause = { assert_kw ~ expr }
requires_clause = { requires_kw ~ expr }
ensures_clause = { ensures_kw ~ expr }
assumes_clause = { assumes_kw ~ expr }
assigns_clause = { assigns_kw ~ assigns_list }
assigns_list = { expr ~ (comma ~ expr)* }

expr = { ternary }
ternary = { iff_expr ~ (qmark ~ expr ~ colon ~ expr)? }

iff_expr = { implies_expr ~ (op_iff ~ implies_expr)* }
implies_expr = { or_expr ~ (op_implies ~ or_expr)* }

or_expr = { and_expr ~ (op_or ~ and_expr)* }
and_expr = { bitor_expr ~ (op_and ~ bitor_expr)* }
bitor_expr = { bitand_expr ~ (op_bitor ~ bitand_expr)* }
bitand_expr = { eq_expr ~ (op_bitand ~ eq_expr)* }

eq_expr = { rel_expr ~ ((op_eq | op_ne) ~ rel_expr)* }
rel_expr = { add_expr ~ ((op_le | op_lt | op_ge | op_gt) ~ add_expr)* }
add_expr = { mul_expr ~ ((op_add | op_sub) ~ mul_expr)* }
mul_expr = { unary_expr ~ ((op_mul | op_div | op_mod) ~ unary_expr)* }

unary_expr = { op_unary* ~ postfix_expr }
postfix_expr = { primary ~ (call | index | member)* }

primary = { quant | number | ident | lparen ~ expr ~ rparen }

quant = { (forall | exists) ~ quant_var_list ~ semicolon ~ expr }
forall = { "\\forall" }
exists = { "\\exists" }

call = { lparen ~ (expr ~ (comma ~ expr)*)? ~ rparen }
index = { lbracket ~ expr ~ rbracket }
member = { (op_arrow | op_dot) ~ ident }

quant_var_list = { quant_var ~ (comma ~ quant_var)* }
quant_var = { ident ~ ident? }
ident = @{ (ASCII_ALPHA | "_" | "\\") ~ (ASCII_ALPHANUMERIC | "_" | "\\")* }
number = @{ ASCII_DIGIT+ }

loop_kw = { "loop" }
invariant_kw = { "invariant" }
assert_kw = { "assert" }
requires_kw = { "requires" }
ensures_kw = { "ensures" }
assumes_kw = { "assumes" }
assigns_kw = { "assigns" }
behavior_kw = { "behavior" }

semicolon = _{ ";" }
comma = _{ "," }
qmark = _{ "?" }
colon = _{ ":" }

op_unary = { "!" | "~" | "+" | "-" }
op_iff = { "<==>" }
op_implies = { "==>" }
op_or = { "||" }
op_and = { "&&" }
op_bitor = { "|" }
op_bitand = { "&" }
op_eq = { "==" }
op_ne = { "!=" }
op_le = { "<=" }
op_lt = { "<" }
op_ge = { ">=" }
op_gt = { ">" }
op_add = { "+" }
op_sub = { "-" }
op_mul = { "*" }
op_div = { "/" }
op_mod = { "%" }
op_arrow = { "->" }
op_dot = { "." }

lparen = _{ "(" }
rparen = _{ ")" }
lbracket = _{ "[" }
rbracket = _{ "]" }
